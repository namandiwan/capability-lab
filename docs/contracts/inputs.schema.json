{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "memberId": {
      "type": "string",
      "pattern": "^\\d{5}$"
    },
    "nickname": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30
    }
  },
  "required": [
    "memberId",
    "nickname"
  ],
  "additionalProperties": false
}
