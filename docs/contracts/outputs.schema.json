{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "balance": {
      "type": "string",
      "pattern": "^\\$\\d{1,3}(,\\d{3})*\\.\\d{2}$"
    },
    "reviewStatus": {
      "type": "string",
      "const": "Ready for approval"
    },
    "reviewProduct": {
      "type": "string",
      "enum": [
        "Savings",
        "Checking"
      ]
    }
  },
  "required": [
    "balance",
    "reviewStatus",
    "reviewProduct"
  ],
  "additionalProperties": false
}
